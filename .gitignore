## --- AL gitignore ---
## Ignores generated binary files and 
## temporary files from Visual Studio and Visual Studio code

# Binary files
.alpackages/
*.app
# Local editor files (launch.json holds machine-specific servers)
app/.vscode/*
!app/.vscode/settings.json
!app/.vscode/rad.json
test/.vscode
# Tool caches
.alcache/
.altemplates/
.snapshots/
.coverage/
# Temp files
.vs/

# Others
~$*
*~
